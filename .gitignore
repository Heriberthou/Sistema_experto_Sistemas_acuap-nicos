# Se conservan sistema/, interfaz/, conocimientos/, documentacion/, pruebas/
# y los archivos necesarios para instalar, ejecutar y entender el proyecto.

# Secretos y configuración local. Las plantillas deben contener solo ejemplos.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.ejemplo
*.pem
*.key
*.p12
*.pfx
credentials.json
credentials.*.json
credenciales.json
credenciales.*.json
secrets.*
secretos.*
service-account*.json
service_account*.json
client_secret*.json
secrets/
secretos/
credentials/
credenciales/
.aws/
.azure/
.ssh/

# Datos locales de ChatGPT, Codex y otros asistentes.
.codex/
.agents/
.chatgpt/
chatgpt/
ChatGPT/
.openai/
.claude/
.cursor/
.aider*

# Entornos, dependencias y cachés. No se ignoran manifiestos ni lockfiles.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
*.egg-info/
.ipynb_checkpoints/
node_modules/
.npm/
.cache/

# Compilaciones y reportes de pruebas.
/build/
/dist/
/htmlcov/
coverage/
.coverage
.coverage.*
coverage.xml
test-results/
playwright-report/
reportes_pruebas/

# Archivos temporales, registros y respaldos locales.
*.log
logs/
.tmp/
tmp/
temp/
temporales/
*.tmp
*.bak
*.swp
*.swo
~$*
/backups/
/respaldos/

# Consultas exportadas por la aplicación, incluidas copias de descargas.
consulta-acuaponia*.json
/exportaciones/
/datos/privados/
/datos/locales/
/data/private/
/data/local/

# Pruebas locales o privadas. Las tres suites públicas sí se versionan.
/pruebas/privadas/
/pruebas/locales/
/pruebas/datos/privados/
/tests/private/
/tests/local/
/tests/fixtures/private/
test_*.local.py
*.local.test.*

# Configuración personal del editor y del sistema operativo.
.vscode/
.idea/
.vs/
.DS_Store
Thumbs.db
Desktop.ini

# Bibliografía y documentos originales: no se necesitan para ejecutar.
/archivos/
/Contenido_simplificado.docx

# Documentación anterior a la adaptación; la vigente está en documentacion/.
/docs/
/GUIA_DE_CAMBIOS.md
